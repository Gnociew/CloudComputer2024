<graph edgedefault="undirected"><node id="&quot;英国空想社会主义&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"英国空想社会主义是19世纪初在英国出现的一种社会主义思想。"</data>
  <data key="d2">chunk-647d404c77c77b74cbb423c12321d4e1</data>
</node>
<node id="&quot;价值评价特点&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"价值评价特点指价值评价的主观性、去客体性、评价结果与评价标准的关系以及评价结果正确性的依赖性。"</data>
  <data key="d2">chunk-deacddec126d0d0961d98e274841fd63</data>
</node>
<node id="&quot;古希腊罗马哲学&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"古希腊罗马哲学是指古希腊和古罗马时期的哲学思想。"</data>
  <data key="d2">chunk-647d404c77c77b74cbb423c12321d4e1</data>
</node>
<node id="&quot;价值的基本特性&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"价值的基本特性包括客观性、主体性、社会历史性、多维性。"</data>
  <data key="d2">chunk-deacddec126d0d0961d98e274841fd63</data>
</node>
<node id="&quot;剩余价值学说&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"剩余价值学说是马克思主义关于资本主义经济运行的基本理论。"&lt;SEP&gt;"剩余价值学说是马克思主义政治经济学的一个核心概念，涉及资本家和工人之间的剥削关系。"</data>
  <data key="d2">chunk-647d404c77c77b74cbb423c12321d4e1&lt;SEP&gt;chunk-2cd8e48eb5d38b75355bba02609c05f3</data>
</node>
<node id="&quot;文艺复兴运动&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"文艺复兴运动是14世纪至17世纪在欧洲兴起的一场思想文化运动。"</data>
  <data key="d2">chunk-647d404c77c77b74cbb423c12321d4e1</data>
</node>
<node id="&quot;价值评价及其特点&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"价值评价及其特点包括评价对象、评价结果与评价标准的关系以及评价结果正确性的依赖性。"</data>
  <data key="d2">chunk-deacddec126d0d0961d98e274841fd63</data>
</node>
<node id="&quot;共产党宣言&quot;">
  <data key="d0">"EVENT"</data>
  <data key="d1">"《共产党宣言》是马克思和恩格斯于1848年发表的政治宣言，标志着马克思主义的诞生。"</data>
  <data key="d2">chunk-647d404c77c77b74cbb423c12321d4e1</data>
</node>
<node id="&quot;价值观与核心价值观&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"价值观与核心价值观的关系包括价值观是核心价值观的组成部分，核心价值观是价值观的核心。"</data>
  <data key="d2">chunk-deacddec126d0d0961d98e274841fd63</data>
</node>
<node id="&quot;两个伟大发现&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"两个伟大发现指的是唯物史观和剩余价值学说，是马克思主义哲学的两个重要基石。"</data>
  <data key="d2">chunk-647d404c77c77b74cbb423c12321d4e1</data>
</node>
<node id="&quot;社会意识发展水平&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"The level of social consciousness development refers to the level of awareness and understanding within a society."</data>
  <data key="d2">chunk-41183860ecf8e9826db112f1097e234e</data>
</node>
<node id="&quot;真理的检验标准&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"真理的检验标准指实践是检验真理的唯一标准。"</data>
  <data key="d2">chunk-deacddec126d0d0961d98e274841fd63</data>
</node>
<node id="&quot;自然科学的物质概念&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"自然科学的物质概念是指自然科学中关于物质的理论和定义。"</data>
  <data key="d2">chunk-647d404c77c77b74cbb423c12321d4e1</data>
</node>
<node id="&quot;经济基础&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"Economic basis refers to the sum of production relations determined by the level of social productivity in a certain stage of development."</data>
  <data key="d2">chunk-41183860ecf8e9826db112f1097e234e</data>
</node>
<node id="&quot;真理的绝对性与相对性关系&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"真理的绝对性与相对性关系指真理永远处在由相对向绝对转化和发展中。"</data>
  <data key="d2">chunk-deacddec126d0d0961d98e274841fd63</data>
</node>
<node id="&quot;唯物史观&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"Materialist historical view is a principle of Marxist philosophy that examines the creators of history based on real people and their essence."&lt;SEP&gt;"唯物史观是马克思主义关于历史发展的根本观点。"&lt;SEP&gt;"唯物史观是马克思主义哲学的基本理论之一，强调物质生活条件对历史进程的决定作用。"&lt;SEP&gt;"唯物史观是马克思主义哲学的基本观点，认为社会存在决定社会意识。"</data>
  <data key="d2">chunk-41183860ecf8e9826db112f1097e234e&lt;SEP&gt;chunk-647d404c77c77b74cbb423c12321d4e1&lt;SEP&gt;chunk-f34069ac08b1c4bc66f348fd5d0391fa&lt;SEP&gt;chunk-2cd8e48eb5d38b75355bba02609c05f3</data>
</node>
<node id="&quot;哲学物质概念&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"哲学物质概念是指哲学中关于物质的理论和定义。"</data>
  <data key="d2">chunk-647d404c77c77b74cbb423c12321d4e1</data>
</node>
<node id="&quot;真理的绝对性&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"真理的绝对性指真理的绝对性是真理的一个方面，指任何真理都标志着主观和客观之间的符合。"</data>
  <data key="d2">chunk-deacddec126d0d0961d98e274841fd63</data>
</node>
<node id="&quot;物质的存在形态&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"The existence form of matter includes movement, time, and space as the form of existence of material movement."&lt;SEP&gt;"物质的存在形态包括物质的根本属性——运动，以及时间和空间作为物质运动的存在形式。"&lt;SEP&gt;"物质的存在形态是指物质的具体表现形式，如固体、液体、气体等。"</data>
  <data key="d2">chunk-647d404c77c77b74cbb423c12321d4e1&lt;SEP&gt;chunk-15983329068bd701678476a4f18ab8b1</data>
</node>
<node id="&quot;警察&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"Police are law enforcement officers responsible for maintaining public order and safety."</data>
  <data key="d2">chunk-41183860ecf8e9826db112f1097e234e</data>
</node>
<node id="&quot;真理的相对性&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"真理的相对性指真理的相对性是真理的另一个方面，指人们在一定条件下对客观事物及其本质和发展规律的正确认识总是有限度和不完善的。"</data>
  <data key="d2">chunk-deacddec126d0d0961d98e274841fd63</data>
</node>
<node id="&quot;客观实在性&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"客观实在性是指物质存在的独立于人类意识的事实。"</data>
  <data key="d2">chunk-647d404c77c77b74cbb423c12321d4e1</data>
</node>
<node id="&quot;上层建筑&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"Superstructure refers to the意识形态 and corresponding institutions and facilities established on a certain economic basis."</data>
  <data key="d2">chunk-41183860ecf8e9826db112f1097e234e</data>
</node>
<node id="&quot;三条界限&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"三条界限包括唯物主义与唯心主义的界限，反映论与先验论的界限，可知论与不可知论的界限，以及辩证唯物主义和旧唯物主义的界限。"</data>
  <data key="d2">chunk-15983329068bd701678476a4f18ab8b1</data>
</node>
<node id="&quot;生产力&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"Productivity is the material force formed in production practice, capable of transforming and affecting nature to adapt to social needs."&lt;SEP&gt;"生产力是指人类利用自然、改造自然的能力，是实现共产主义社会的一个重要特征。"&lt;SEP&gt;"生产力是指在一定生产关系中，劳动者和生产资料结合所产生的能力。"</data>
  <data key="d2">chunk-8bedb2f5fc0b60aee0c375ed03c7a25d&lt;SEP&gt;chunk-f6d2f6068f9eee510b0e78ccec922ca2&lt;SEP&gt;chunk-41183860ecf8e9826db112f1097e234e</data>
</node>
<node id="&quot;历史&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"History refers to the past events and developments that have shaped the world and society."</data>
  <data key="d2">chunk-41183860ecf8e9826db112f1097e234e</data>
</node>
<node id="&quot;三个统一&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"三个统一包括唯物论与唯心论的统一，本体论与认知论的统一，自然观与历史观的统一。"</data>
  <data key="d2">chunk-15983329068bd701678476a4f18ab8b1</data>
</node>
<node id="&quot;科学社会主义&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"科学社会主义是马克思主义政治经济学和哲学的实践应用，强调通过社会主义实现无产阶级解放和共产主义。"&lt;SEP&gt;"科学社会主义是马克思和恩格斯创立的社会主义理论体系。"</data>
  <data key="d2">chunk-647d404c77c77b74cbb423c12321d4e1&lt;SEP&gt;chunk-2cd8e48eb5d38b75355bba02609c05f3</data>
</node>
<node id="&quot;社会和谐&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"社会和谐是指社会关系高度和谐，人们精神境界极大提高的状态。"</data>
  <data key="d2">chunk-f6d2f6068f9eee510b0e78ccec922ca2</data>
</node>
<node id="&quot;物质与意识的辩证关系&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"The dialectical relationship between matter and consciousness includes the origin of consciousness, the essence of consciousness, and the nature of consciousness."&lt;SEP&gt;"物质与意识的辩证关系包括物质决定意识，意识对物质有反作用，以及主观能动性与客观规律性的关系。"</data>
  <data key="d2">chunk-15983329068bd701678476a4f18ab8b1</data>
</node>
<node id="&quot;三大差别&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"三大差别指的是工业与农业、城市与乡村、脑力劳动与体力劳动之间的差别，这些差别在共产主义社会中将归于消失。"&lt;SEP&gt;"三大差别是指工业与农业、城市与乡村、脑力劳动与体力劳动之间的差别。"</data>
  <data key="d2">chunk-f6d2f6068f9eee510b0e78ccec922ca2&lt;SEP&gt;chunk-2cd8e48eb5d38b75355bba02609c05f3</data>
</node>
<node id="&quot;物质性&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"物质性是指物质存在的本质属性，包括物质的运动和变化，以及时间和空间作为物质运动的存在形式。"</data>
  <data key="d2">chunk-15983329068bd701678476a4f18ab8b1</data>
</node>
<node id="&quot;自由而全面的发展&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"自由而全面的发展是指每个人自由而全面的发展，是人类社会发展的根本价值目标。"</data>
  <data key="d2">chunk-f6d2f6068f9eee510b0e78ccec922ca2</data>
</node>
<node id="&quot;法庭&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"Court is a legal institution that administers justice and enforces laws."</data>
  <data key="d2">chunk-41183860ecf8e9826db112f1097e234e</data>
</node>
<node id="&quot;物质的根本属性&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"The fundamental attribute of matter is movement, which is the sign of change and process in all things and phenomena."</data>
  <data key="d2">chunk-15983329068bd701678476a4f18ab8b1</data>
</node>
<node id="&quot;两个必然&quot;">
  <data key="d0">"EVENT"</data>
  <data key="d1">"两个必然是指社会主义必然胜利和共产主义必然实现的预测。"</data>
  <data key="d2">chunk-f6d2f6068f9eee510b0e78ccec922ca2</data>
</node>
<node id="&quot;时间和空间&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"Time and space are the forms of existence of material movement, with time being the continuity and sequence of material movement, and space being the extension and expansion."</data>
  <data key="d2">chunk-15983329068bd701678476a4f18ab8b1</data>
</node>
<node id="&quot;马克思主义的创立和发展&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"马克思主义的创立和发展是关于马克思主义哲学的历史和理论发展。"</data>
  <data key="d2">chunk-647d404c77c77b74cbb423c12321d4e1</data>
</node>
<node id="&quot;会关系&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"会关系 refers to social relationships, a key aspect of the ideal communist society that emphasizes harmony."</data>
  <data key="d2">chunk-f6d2f6068f9eee510b0e78ccec922ca2</data>
</node>
<node id="&quot;相对静止&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"Relative stillness is the stable state of material movement under certain conditions, indicating the variability of material movement and the relativity of stillness."</data>
  <data key="d2">chunk-15983329068bd701678476a4f18ab8b1</data>
</node>
<node id="&quot;哲学基本问题&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"哲学基本问题是哲学研究中的一些基本问题，如存在和思维的关系。"</data>
  <data key="d2">chunk-647d404c77c77b74cbb423c12321d4e1</data>
</node>
<node id="&quot;精神境界&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"精神境界 pertains to the spiritual and moral level of individuals in a society, which is claimed to be greatly elevated in a communist society."</data>
  <data key="d2">chunk-f6d2f6068f9eee510b0e78ccec922ca2</data>
</node>
<node id="&quot;物质运动&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"Material movement refers to the movement of matter itself, where matter is the matter in movement, and movement is inseparable from matter."</data>
  <data key="d2">chunk-15983329068bd701678476a4f18ab8b1</data>
</node>
<node id="&quot;唯物主义&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"唯物主义是一种哲学观点，强调物质是世界的本原，一切现象都可以归结为物质的运动和变化。"&lt;SEP&gt;"唯物主义是一种哲学观点，认为物质是构成世界的基础，意识是物质的产物。"</data>
  <data key="d2">chunk-647d404c77c77b74cbb423c12321d4e1&lt;SEP&gt;chunk-15983329068bd701678476a4f18ab8b1</data>
</node>
<node id="&quot;脑力劳动&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"脑力劳动 refers to intellectual labor, one of the 'three great differences' that are said to be eliminated in a communist society."</data>
  <data key="d2">chunk-f6d2f6068f9eee510b0e78ccec922ca2</data>
</node>
<node id="&quot;物质世界的时空&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"The time and space of the material world are infinite, reflecting the unlimited nature of the material world."</data>
  <data key="d2">chunk-15983329068bd701678476a4f18ab8b1</data>
</node>
<node id="&quot;体力劳动&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"体力劳动 refers to physical labor, another of the 'three great differences' that are said to be eliminated in a communist society."</data>
  <data key="d2">chunk-f6d2f6068f9eee510b0e78ccec922ca2</data>
</node>
<node id="&quot;唯心主义&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"唯心主义是一种哲学观点，认为意识是构成世界的基础，物质是意识的产物。"</data>
  <data key="d2">chunk-647d404c77c77b74cbb423c12321d4e1</data>
</node>
<node id="&quot;实践是自然存在和社会存在区分和细解社会生活的本质&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"Practice is the historical premise for the differentiation of nature and society, and the key to understanding the essence of social life."</data>
  <data key="d2">chunk-15983329068bd701678476a4f18ab8b1</data>
</node>
<node id="&quot;形而上学唯物主义&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"形而上学唯物主义是一种哲学观点，认为物质是构成世界的基础，但忽视了物质的动态性质。"</data>
  <data key="d2">chunk-647d404c77c77b74cbb423c12321d4e1</data>
</node>
<node id="&quot;物质存在条件&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"物质存在条件 refers to the conditions that must exist in order for the new social order to emerge."&lt;SEP&gt;"物质存在条件 refers to the material conditions that are necessary for the emergence of a new social order, as described in the text."</data>
  <data key="d2">chunk-f6d2f6068f9eee510b0e78ccec922ca2</data>
</node>
<node id="&quot;实践是使物质从实践中来的&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"Practice is the source of matter, and the entire space-time of the material world is infinite."</data>
  <data key="d2">chunk-15983329068bd701678476a4f18ab8b1</data>
</node>
<node id="&quot;绪论&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"绪论是某本书或课程的开篇部分，通常介绍主题和目的。"</data>
  <data key="d2">chunk-647d404c77c77b74cbb423c12321d4e1</data>
</node>
<node id="&quot;旧社会&quot;">
  <data key="d0">"GEO"</data>
  <data key="d1">"旧社会 refers to the existing social order that is being criticized and eventually replaced by communism."&lt;SEP&gt;"旧社会 refers to the previous social order that is being replaced by the communist society described in the text."</data>
  <data key="d2">chunk-f6d2f6068f9eee510b0e78ccec922ca2</data>
</node>
<node id="&quot;两个大的方面&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"Two major aspects include practice as the historical premise for the differentiation of nature and society, and practice as the foundation of human society."</data>
  <data key="d2">chunk-15983329068bd701678476a4f18ab8b1</data>
</node>
<node id="&quot;正方形方框标识&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"正方形方框标识是一种标记方式，用于突出分析题或重要内容。"</data>
  <data key="d2">chunk-647d404c77c77b74cbb423c12321d4e1</data>
</node>
<node id="&quot;新社会&quot;">
  <data key="d0">"GEO"</data>
  <data key="d1">"新社会 refers to the communist society that is being established as a replacement for the old social order."&lt;SEP&gt;"新社会 refers to the communist society that is envisioned as the successor to the old social order."</data>
  <data key="d2">chunk-f6d2f6068f9eee510b0e78ccec922ca2</data>
</node>
<node id="&quot;意识的本质&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"The essence of consciousness includes its origin from the stimulation and response of nature, the development from the sensory and psychological functions of higher animals, and the formation through social practice, especially labor."</data>
  <data key="d2">chunk-15983329068bd701678476a4f18ab8b1</data>
</node>
<node id="&quot;辩证法&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"辩证法是一种哲学思想，强调事物的矛盾运动和发展变化。"&lt;SEP&gt;"辩证法是一种哲学方法，强调事物之间的联系和发展，包含对立统一规律、质量互变规律、否定之否定规律等。"&lt;SEP&gt;"辩证法是一种哲学方法，强调事物内部的矛盾是事物发展的根本动力，通过分析矛盾的运动和解决来认识世界和改造世界。"&lt;SEP&gt;"辩证法是一种哲学方法，强调事物的矛盾和变化，以及这些矛盾和变化如何推动事物的发展。"</data>
  <data key="d2">chunk-0b6bf3666a0dd8ae9256389cd5fd47f0&lt;SEP&gt;chunk-647d404c77c77b74cbb423c12321d4e1&lt;SEP&gt;chunk-15983329068bd701678476a4f18ab8b1</data>
</node>
<node id="&quot;胎胞&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"胎胞 metaphorically refers to the condition of the old society within which the new, communist society is developing."</data>
  <data key="d2">chunk-f6d2f6068f9eee510b0e78ccec922ca2</data>
</node>
<node id="&quot;意识的反映特性&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"The reflective characteristics of consciousness refer to its ability to reflect the external world."</data>
  <data key="d2">chunk-15983329068bd701678476a4f18ab8b1</data>
</node>
<node id="&quot;胜利&quot;">
  <data key="d0">"EVENT"</data>
  <data key="d1">"胜利 here is used metaphorically to describe the success or triumph of socialism and communism."&lt;SEP&gt;"胜利 refers to the achievement of a goal or the overcoming of an adversary, as mentioned in the context of the victory of socialism and communism."</data>
  <data key="d2">chunk-f6d2f6068f9eee510b0e78ccec922ca2</data>
</node>
<node id="&quot;意识的社会历史发展&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"The social and historical development of consciousness includes the evolution of consciousness from the stimulus and response of lower animals to the sensory and psychological functions of higher animals."</data>
  <data key="d2">chunk-15983329068bd701678476a4f18ab8b1</data>
</node>
<node id="&quot;灭亡&quot;">
  <data key="d0">"EVENT"</data>
  <data key="d1">"灭亡 here is used metaphorically to describe the end of the old social order."&lt;SEP&gt;"灭亡 refers to the end or destruction of a social order, as described in the text."</data>
  <data key="d2">chunk-f6d2f6068f9eee510b0e78ccec922ca2</data>
</node>
<node id="&quot;意识的机能和属性&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"The functions and attributes of consciousness include its role in the human cognitive process."</data>
  <data key="d2">chunk-15983329068bd701678476a4f18ab8b1</data>
</node>
<node id="&quot;成熟&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"成熟 refers to the development to a point of readiness or completion, as described in the context of the maturation of the new society within the old."</data>
  <data key="d2">chunk-f6d2f6068f9eee510b0e78ccec922ca2</data>
</node>
<node id="&quot;意识的客观性&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"The objectivity of consciousness refers to its nature as a reflection of the external world."</data>
  <data key="d2">chunk-15983329068bd701678476a4f18ab8b1</data>
</node>
<node id="&quot;马克思主义哲学&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"马克思主义哲学是关于物质统一性的哲学体系，是唯物辩证法的基石。"</data>
  <data key="d2">chunk-0b6bf3666a0dd8ae9256389cd5fd47f0</data>
</node>
<node id="&quot;意识的产生和发展&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"The generation and development of consciousness include its origin from the stimulation and response of nature to the sensory and psychological functions of higher animals."</data>
  <data key="d2">chunk-15983329068bd701678476a4f18ab8b1</data>
</node>
<node id="&quot;物质统一性&quot;">
  <data key="d0">"CONCEPT"</data>
  <data key="d1">"物质统一性是指物质世界的统一性，体现在物质与意识、人类社会与物质世界的统一性。"&lt;SEP&gt;"物质统一性是马克思主义哲学的核心概念，强调世界的物质性和统一性。"</data>
  <data key="d2">chunk-0b6bf3666a0dd8ae9256389cd5fd47f0&lt;SEP&gt;chunk-15983329068bd701678476a4f18ab8b1</data>
</node>
<node id="&quot;社会革命&quot;">
  <data key="d0">"EVENT"</data>
  <data key="d1">"Social revolution is a major event in social development that involves significant changes in social structure."</data>
  <data key="d2">chunk-41183860ecf8e9826db112f1097e234e</data>
</node>
<node id="&quot;意识的反映特性到意识的人的机能和属性&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"The evolution of consciousness from the reflective characteristics to the functions and attributes of human consciousness."</data>
  <data key="d2">chunk-15983329068bd701678476a4f18ab8b1</data>
</node>
<node id="&quot;社会历史趋向&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"社会历史趋向是指社会发展的方向和趋势，体现了社会历史的发展规律。"</data>
  <data key="d2">chunk-0b6bf3666a0dd8ae9256389cd5fd47f0</data>
</node>
<node id="&quot;意识是客观存在的反映&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"Consciousness is a reflection of the objective world."</data>
  <data key="d2">chunk-15983329068bd701678476a4f18ab8b1</data>
</node>
<node id="&quot;主观能动性&quot;">
  <data key="d0">"CONCEPT"</data>
  <data key="d1">"主观能动性是指人们在社会历史发展中的积极性和创造性。"</data>
  <data key="d2">chunk-0b6bf3666a0dd8ae9256389cd5fd47f0</data>
</node>
<node id="&quot;改革&quot;">
  <data key="d0">"EVENT"</data>
  <data key="d1">"Reform is an important driving force for social development, involving changes in social systems and structures."</data>
  <data key="d2">chunk-41183860ecf8e9826db112f1097e234e</data>
</node>
<node id="&quot;意识是社会历史的产物&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"Consciousness is a product of social and historical development."</data>
  <data key="d2">chunk-15983329068bd701678476a4f18ab8b1</data>
</node>
<node id="&quot;物质资料生产方式&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"物质资料生产方式是人类社会存在和发展的基础，指人类获取生活资料的方式。"</data>
  <data key="d2">chunk-0b6bf3666a0dd8ae9256389cd5fd47f0</data>
</node>
<node id="&quot;社会基本矛盾&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"Social fundamental contradictions are the contradictions between productive forces and production relations, and between economic basis and superstructure."</data>
  <data key="d2">chunk-41183860ecf8e9826db112f1097e234e</data>
</node>
<node id="&quot;意识的人的能动性&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"The subjective initiative of human consciousness includes its purposeful and creative activities."</data>
  <data key="d2">chunk-15983329068bd701678476a4f18ab8b1</data>
</node>
<node id="&quot;唯物辩证法&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"唯物辩证法是一种哲学方法，强调事物之间的联系和发展，包含对立统一规律、质量互变规律、否定之否定规律等。"&lt;SEP&gt;"唯物辩证法是哲学上的一种方法论，强调事物发展的客观规律和辩证关系。"</data>
  <data key="d2">chunk-0b6bf3666a0dd8ae9256389cd5fd47f0&lt;SEP&gt;chunk-2b0ae703b9160ae0b111f99f11ae13c4</data>
</node>
<node id="&quot;意识的客观规律性与主观能动性&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"The objective laws and subjective initiative of consciousness include the relationship between objective laws and subjective initiative in human activities."</data>
  <data key="d2">chunk-15983329068bd701678476a4f18ab8b1</data>
</node>
<node id="&quot;联系与发展的普遍性&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"联系与发展的普遍性是指事物之间普遍存在的联系和发展规律。"&lt;SEP&gt;"联系与发展的普遍性是指事物之间的相互联系和发展的普遍规律。"</data>
  <data key="d2">chunk-0b6bf3666a0dd8ae9256389cd5fd47f0</data>
</node>
<node id="&quot;客观规律性与主观能动性的关系&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"The relationship between objective laws and subjective initiative includes the objective nature of laws and the subjective nature of human activities."</data>
  <data key="d2">chunk-15983329068bd701678476a4f18ab8b1</data>
</node>
<node id="&quot;对立统一规律&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"对立统一规律是唯物辩证法的根本规律，强调事物内部的矛盾是事物发展的动力。"&lt;SEP&gt;"对立统一规律是辩证法的基本规律，强调事物内部矛盾的统一和斗争。"</data>
  <data key="d2">chunk-0b6bf3666a0dd8ae9256389cd5fd47f0</data>
</node>
<node id="&quot;认识和利用规律&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"The recognition and utilization of laws include the correct understanding and application of objective laws in human practice."</data>
  <data key="d2">chunk-15983329068bd701678476a4f18ab8b1</data>
</node>
<node id="&quot;质量互变规律&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"质量互变规律是唯物辩证法的基本规律之一，指事物在量变积累到一定程度时会发生质变。"&lt;SEP&gt;"质量互变规律是辩证法的基本规律，指事物在量变达到一定程度时会引起质变。"</data>
  <data key="d2">chunk-0b6bf3666a0dd8ae9256389cd5fd47f0</data>
</node>
<node id="&quot;这&quot;">
  <data key="d0">"PERSON"</data>
  <data key="d1">"这 是一个虚构的人物。"&gt;</data>
  <data key="d2">chunk-22fb66d705b5f4290449caf8ec401ec0</data>
</node>
<node id="&quot;尊重客观规律是发挥人的主观能动性的前提&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"Respecting objective laws is the premise for giving full play to human subjective initiative."</data>
  <data key="d2">chunk-15983329068bd701678476a4f18ab8b1</data>
</node>
<node id="&quot;否定之否定规律&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"否定之否定规律是事物发展的前进性与曲折性的统一，是事物自我否定的过程。"&gt;&lt;SEP&gt;"否定之否定规律是唯物辩证法的基本规律之一，指事物发展过程中的自我否定和自我超越。"&lt;SEP&gt;"否定之否定规律是辩证法的基本规律，指事物发展过程中的自我否定和自我超越。"</data>
  <data key="d2">chunk-0b6bf3666a0dd8ae9256389cd5fd47f0&lt;SEP&gt;chunk-22fb66d705b5f4290449caf8ec401ec0</data>
</node>
<node id="&quot;军队&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"Military refers to the organized force with equipment, trained for war and other defense and security purposes."</data>
  <data key="d2">chunk-41183860ecf8e9826db112f1097e234e</data>
</node>
<node id="&quot;发挥人的主观能动性&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"Giving full play to human subjective initiative includes actively engaging in practice to change the objective world."</data>
  <data key="d2">chunk-15983329068bd701678476a4f18ab8b1</data>
</node>
<node id="&quot;矛盾分析法&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"矛盾分析法是唯物辩证法的基本方法，通过分析事物内部的矛盾来认识事物的发展规律。"&lt;SEP&gt;"矛盾分析法是辩证法的基本方法，通过分析事物内部的矛盾来认识事物的发展规律。"</data>
  <data key="d2">chunk-0b6bf3666a0dd8ae9256389cd5fd47f0</data>
</node>
<node id="&quot;矛盾的同一性与斗争性&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"矛盾的同一性与斗争性是指矛盾的两个方面既相互依存又相互排斥，是事物发展的动力。"</data>
  <data key="d2">chunk-0b6bf3666a0dd8ae9256389cd5fd47f0</data>
</node>
<node id="&quot;现实与可能&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"现实与可能是指事物发展的当前状态和未来可能的状态。"</data>
  <data key="d2">chunk-0b6bf3666a0dd8ae9256389cd5fd47f0</data>
</node>
<node id="&quot;事物发展的根本规律&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"事物发展的根本规律是指推动事物发展的基本规律，包括对立统一规律、质量互变规律、否定之否定规律等。"</data>
  <data key="d2">chunk-0b6bf3666a0dd8ae9256389cd5fd47f0</data>
</node>
<node id="&quot;科学技术&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"Science and technology play a crucial role in social development."</data>
  <data key="d2">chunk-41183860ecf8e9826db112f1097e234e</data>
</node>
<node id="&quot;世界利&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"世界利可能指的是世界发展的有利条件和趋势。"</data>
  <data key="d2">chunk-0b6bf3666a0dd8ae9256389cd5fd47f0</data>
</node>
<node id="&quot;物质&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"物质是指构成世界的基本实体，包括所有有形的和无形的物质形态。"</data>
  <data key="d2">chunk-0b6bf3666a0dd8ae9256389cd5fd47f0</data>
</node>
<node id="&quot;生活资料&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"生活资料是指人类为了生存和发展所必需的物质条件。"</data>
  <data key="d2">chunk-0b6bf3666a0dd8ae9256389cd5fd47f0</data>
</node>
<node id="&quot;发展规律&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"发展规律是指事物发展的必然趋势和内在规律。"</data>
  <data key="d2">chunk-0b6bf3666a0dd8ae9256389cd5fd47f0</data>
</node>
<node id="&quot;阶级斗争&quot;">
  <data key="d0">"EVENT"</data>
  <data key="d1">"Class struggle is the direct driving force for the development of class societies."</data>
  <data key="d2">chunk-41183860ecf8e9826db112f1097e234e</data>
</node>
<node id="&quot;实际出发&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"实际出发是指从实际情况出发，根据客观事实进行思考和行动。"</data>
  <data key="d2">chunk-0b6bf3666a0dd8ae9256389cd5fd47f0</data>
</node>
<node id="&quot;农民&quot;">
  <data key="d0">"PERSON"</data>
  <data key="d1">"农民是劳动力的提供者，在资本主义体系中可能遭受剥削，其劳动力被视为商品。"</data>
  <data key="d2">chunk-0697a0db7d0db1790ba106df67fce0aa</data>
</node>
<node id="&quot;劳动力&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"劳动力在此文本中指的是劳动者的能力，被视为商品，其价值由工资体现。"</data>
  <data key="d2">chunk-0697a0db7d0db1790ba106df67fce0aa</data>
</node>
<node id="&quot;工资&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"工资是劳动者提供的劳动力所得到的报酬，是劳动力商品的价值体现。"</data>
  <data key="d2">chunk-0697a0db7d0db1790ba106df67fce0aa</data>
</node>
<node id="&quot;物质力量&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"Material force is the physical power that can be utilized to achieve certain goals or objectives."</data>
  <data key="d2">chunk-41183860ecf8e9826db112f1097e234e</data>
</node>
<node id="&quot;资本家&quot;">
  <data key="d0">"PERSON"</data>
  <data key="d1">"资本家是资本主义体系中的生产资料所有者，通过雇佣劳动者生产剩余价值。"</data>
  <data key="d2">chunk-0697a0db7d0db1790ba106df67fce0aa</data>
</node>
<node id="&quot;生产资料&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"Means of production, such as machinery, raw materials, and tools, used in the production process."&lt;SEP&gt;"生产资料是指资本家用于生产商品的工具和资源，如原材料和机器。"&lt;SEP&gt;"生产资料是生产过程中所使用的工具、设备、原材料等物质条件。"</data>
  <data key="d2">chunk-8bedb2f5fc0b60aee0c375ed03c7a25d&lt;SEP&gt;chunk-0697a0db7d0db1790ba106df67fce0aa&lt;SEP&gt;chunk-d46c22c1829ce5c303d173ac88e54caf</data>
</node>
<node id="&quot;剩余价值&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"剩余价值是工人创造的超过其工资的价值，为资本家所有，是资本主义生产方式的绝对规律。"&lt;SEP&gt;"剩余价值是指工人在剩余劳动时间内创造的价值，是资本家对工人的剥削程度的一个标志。"</data>
  <data key="d2">chunk-0697a0db7d0db1790ba106df67fce0aa&lt;SEP&gt;chunk-d46c22c1829ce5c303d173ac88e54caf</data>
</node>
<node id="&quot;汪汪&quot;">
  <data key="d0">"PERSON"</data>
  <data key="d1">"汪汪 是一个虚构的人物。"&gt;</data>
  <data key="d2">chunk-22fb66d705b5f4290449caf8ec401ec0</data>
</node>
<node id="&quot;资本主义所有制&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"资本主义所有制是指生产资料的所有权掌握在资本家手中，劳动者被雇佣以生产剩余价值。"</data>
  <data key="d2">chunk-0697a0db7d0db1790ba106df67fce0aa</data>
</node>
<node id="&quot;劳动对象&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"Labor object refers to the materials, resources, or things that are transformed through human labor."</data>
  <data key="d2">chunk-41183860ecf8e9826db112f1097e234e</data>
</node>
<node id="&quot;剥削&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"剥削是指资本家利用对生产资料的占有，无偿占有工人的剩余劳动，体现为资本家与雇佣劳动之间的对抗关系。"</data>
  <data key="d2">chunk-0697a0db7d0db1790ba106df67fce0aa</data>
</node>
<node id="&quot;雇佣劳动&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"雇佣劳动是指工人以工资形式出卖自己的劳动力，为资本家生产剩余价值。"</data>
  <data key="d2">chunk-0697a0db7d0db1790ba106df67fce0aa</data>
</node>
<node id="&quot;资本主义生产方式&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"资本主义生产方式是一种生产方式，其目的是为了创造剩余价值，通过雇佣劳动和生产资料的结合来实现。"</data>
  <data key="d2">chunk-0697a0db7d0db1790ba106df67fce0aa</data>
</node>
<node id="&quot;货币&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"货币是商品交换发展到一定阶段的产物，具有价值尺度和流通手段等职能。"&lt;SEP&gt;"货币是资本主义体系中用于交换和计价的工具。"</data>
  <data key="d2">chunk-8bedb2f5fc0b60aee0c375ed03c7a25d&lt;SEP&gt;chunk-0697a0db7d0db1790ba106df67fce0aa</data>
</node>
<node id="&quot;监狱&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"Prison is a place for detaining people who have been convicted of crimes and are serving sentences."</data>
  <data key="d2">chunk-41183860ecf8e9826db112f1097e234e</data>
</node>
<node id="&quot;商品&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"商品是资本主义体系中用于交换的物品，具有使用价值和价值。"</data>
  <data key="d2">chunk-0697a0db7d0db1790ba106df67fce0aa</data>
</node>
<node id="&quot;客观规律&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"Objective laws are the fundamental principles that govern the functioning of the natural and social world."</data>
  <data key="d2">chunk-41183860ecf8e9826db112f1097e234e</data>
</node>
<node id="&quot;资本&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"资本是指资本家用于投资的货币或生产资料，目的是为了获取利润。"</data>
  <data key="d2">chunk-0697a0db7d0db1790ba106df67fce0aa</data>
</node>
<node id="&quot;劳动者&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"Laborer refers to an individual who engages in productive labor, contributing to the production process."</data>
  <data key="d2">chunk-41183860ecf8e9826db112f1097e234e</data>
</node>
<node id="&quot;商品生产&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"商品生产是指资本主义体系中生产商品的过程，目的是为了交换和获取利润。"</data>
  <data key="d2">chunk-0697a0db7d0db1790ba106df67fce0aa</data>
</node>
<node id="&quot;价值增殖过程&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"价值增殖过程是资本主义生产过程中，通过劳动创造价值并实现价值增值的过程。"</data>
  <data key="d2">chunk-0697a0db7d0db1790ba106df67fce0aa</data>
</node>
<node id="&quot;人民和群众&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"The people and the masses are the creators of history, according to Marxist historical materialism."</data>
  <data key="d2">chunk-41183860ecf8e9826db112f1097e234e</data>
</node>
<node id="&quot;劳动力价值&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"The value of labor power, which is the cost of the necessary labor to reproduce the worker's labor power."&lt;SEP&gt;"劳动力价值是指劳动力在市场上表现出来的价值。"&lt;SEP&gt;"劳动力价值是指维持劳动者生存和再生产所必需的最低生活水平的价值。"</data>
  <data key="d2">chunk-8bedb2f5fc0b60aee0c375ed03c7a25d&lt;SEP&gt;chunk-0697a0db7d0db1790ba106df67fce0aa&lt;SEP&gt;chunk-d46c22c1829ce5c303d173ac88e54caf</data>
</node>
<node id="&quot;版&quot;">
  <data key="d0">"PERSON"</data>
  <data key="d1">"版 是一个虚构的人物。"&gt;</data>
  <data key="d2">chunk-22fb66d705b5f4290449caf8ec401ec0</data>
</node>
<node id="&quot;必要劳动&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"必要劳动是指劳动者为了维持自身生存和再生产所必须进行的劳动。"</data>
  <data key="d2">chunk-0697a0db7d0db1790ba106df67fce0aa</data>
</node>
<node id="&quot;剩余劳动&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"The surplus labor performed by workers beyond the necessary labor, which generates surplus value for the capitalist."&lt;SEP&gt;"剩余劳动是指劳动者超出必要劳动之外，为资本家生产的无偿劳动。"</data>
  <data key="d2">chunk-0697a0db7d0db1790ba106df67fce0aa&lt;SEP&gt;chunk-d46c22c1829ce5c303d173ac88e54caf</data>
</node>
<node id="&quot;价值转移&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"价值转移是指在资本主义生产过程中，生产资料的价值转移到新产品中。"</data>
  <data key="d2">chunk-0697a0db7d0db1790ba106df67fce0aa</data>
</node>
<node id="&quot;流动资本&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"流动资本是指在生产过程中用于购买原材料、燃料和劳动力的资本。"</data>
  <data key="d2">chunk-0697a0db7d0db1790ba106df67fce0aa</data>
</node>
<node id="&quot;固定资本&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"固定资本是指在生产过程中用于购买机器、厂房等不易消耗的生产资料。"</data>
  <data key="d2">chunk-0697a0db7d0db1790ba106df67fce0aa</data>
</node>
<node id="&quot;不变资本&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"不变资本是指在生产过程中不增加价值的资本，如购买生产资料。"&lt;SEP&gt;"不变资本是指在生产过程中不改变自己价值量的资本，如机器、厂房等固定资产。"</data>
  <data key="d2">chunk-0697a0db7d0db1790ba106df67fce0aa&lt;SEP&gt;chunk-d46c22c1829ce5c303d173ac88e54caf</data>
</node>
<node id="&quot;可变资本&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"可变资本是指在生产过程中改变价值量的资本，如劳动力价值加上剩余价值。"&lt;SEP&gt;"可变资本是指在生产过程中能够增加价值的资本，如支付给工人的工资。"</data>
  <data key="d2">chunk-0697a0db7d0db1790ba106df67fce0aa&lt;SEP&gt;chunk-d46c22c1829ce5c303d173ac88e54caf</data>
</node>
<node id="&quot;资本主义生产目的&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"资本主义生产目的是为了创造利润，这是资本主义生产的直接动机。"</data>
  <data key="d2">chunk-0697a0db7d0db1790ba106df67fce0aa</data>
</node>
<node id="&quot;剩余价值规律&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"剩余价值规律是资本主义生产方式的绝对规律，即资本家通过剥削雇佣劳动获得剩余价值。"</data>
  <data key="d2">chunk-0697a0db7d0db1790ba106df67fce0aa</data>
</node>
<node id="&quot;AD&quot;">
  <data key="d0">"PERSON"</data>
  <data key="d1">"AD 是一个虚构的人物。"&gt;</data>
  <data key="d2">chunk-22fb66d705b5f4290449caf8ec401ec0</data>
</node>
<node id="&quot;价值量&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"价值量是指商品中包含的社会必要劳动时间的量。"</data>
  <data key="d2">chunk-0697a0db7d0db1790ba106df67fce0aa</data>
</node>
<node id="&quot;生产资料形态&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"生产资料形态是指资本在生产过程中采取的不同形式，如原材料和机器。"</data>
  <data key="d2">chunk-0697a0db7d0db1790ba106df67fce0aa</data>
</node>
<node id="&quot;政党&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"Political party is an organized group that seeks to influence or obtain control over the government."</data>
  <data key="d2">chunk-41183860ecf8e9826db112f1097e234e</data>
</node>
<node id="&quot;具体劳动&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"具体劳动是指生产过程中具体的操作和劳动。"</data>
  <data key="d2">chunk-0697a0db7d0db1790ba106df67fce0aa</data>
</node>
<node id="&quot;抽象劳动&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"抽象劳动是指撇开具体形式的一般人类劳动。"</data>
  <data key="d2">chunk-0697a0db7d0db1790ba106df67fce0aa</data>
</node>
<node id="&quot;价值形成过程&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"价值形成过程是指生产过程中价值产生和形成的过程。"</data>
  <data key="d2">chunk-0697a0db7d0db1790ba106df67fce0aa</data>
</node>
<node id="&quot;商品价值&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"商品价值是指商品中包含的劳动价值。"</data>
  <data key="d2">chunk-0697a0db7d0db1790ba106df67fce0aa</data>
</node>
<node id="&quot;商品生产者&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"商品生产者是指生产商品的个体或集体。"</data>
  <data key="d2">chunk-0697a0db7d0db1790ba106df67fce0aa</data>
</node>
<node id="&quot;社会必要劳动时间&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"The socially necessary labor time required to produce a commodity, which is determined by the average labor time in a given society."&lt;SEP&gt;"社会必要劳动时间是在一定的生产条件下，生产某种商品所必需的平均劳动时间。"&lt;SEP&gt;"社会必要劳动时间是指在一定的生产条件下，生产某种商品所必需的平均劳动时间。"</data>
  <data key="d2">chunk-8bedb2f5fc0b60aee0c375ed03c7a25d&lt;SEP&gt;chunk-0697a0db7d0db1790ba106df67fce0aa&lt;SEP&gt;chunk-d46c22c1829ce5c303d173ac88e54caf</data>
</node>
<node id="&quot;价值规律&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"价值规律是商品经济的基本规律，决定了商品的价值量由生产商品的社会必要劳动时间决定，并支配商品生产和商品交换的全过程。"&lt;SEP&gt;"价值规律是指商品的价值取决于生产该商品所必需的社会必要劳动时间。"</data>
  <data key="d2">chunk-8bedb2f5fc0b60aee0c375ed03c7a25d&lt;SEP&gt;chunk-0697a0db7d0db1790ba106df67fce0aa</data>
</node>
<node id="&quot;生产过程两重性&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"生产过程两重性是指资本主义生产过程既是物质资料的生产过程，也是剩余价值的生产过程。"</data>
  <data key="d2">chunk-0697a0db7d0db1790ba106df67fce0aa</data>
</node>
<node id="&quot;资本积累&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"资本积累是指资本主义生产过程中，资本家通过剩余价值转化为资本的过程。"&lt;SEP&gt;"资本积累是指资本家利用剩余价值来扩大自己的资本规模，进一步扩大和加强对工人的剥削和统治。"&lt;SEP&gt;"资本积累是指资本家通过剩余价值再投资来扩大生产规模。"</data>
  <data key="d2">chunk-8bedb2f5fc0b60aee0c375ed03c7a25d&lt;SEP&gt;chunk-0697a0db7d0db1790ba106df67fce0aa&lt;SEP&gt;chunk-d46c22c1829ce5c303d173ac88e54caf</data>
</node>
<node id="&quot;由&quot;">
  <data key="d0">"PERSON"</data>
  <data key="d1">"由 是一个虚构的人物。"&gt;</data>
  <data key="d2">chunk-22fb66d705b5f4290449caf8ec401ec0</data>
</node>
<node id="&quot;资本循环&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"资本循环是指资本在购买生产资料、雇佣劳动、生产商品、销售商品和再购买生产资料的过程中不断循环。"</data>
  <data key="d2">chunk-0697a0db7d0db1790ba106df67fce0aa</data>
</node>
<node id="&quot;国家政权机构&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"State power institutions refer to the organizations and structures through which a state exercises its authority and governs its citizens."</data>
  <data key="d2">chunk-41183860ecf8e9826db112f1097e234e</data>
</node>
<node id="&quot;资本周转&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"资本周转是指资本在不同生产阶段之间流动的速度。"</data>
  <data key="d2">chunk-0697a0db7d0db1790ba106df67fce0aa</data>
</node>
<node id="&quot;王 0&quot;">
  <data key="d0">"PERSON"</data>
  <data key="d1">"王 0 是一个虚构的人物。"&gt;</data>
  <data key="d2">chunk-22fb66d705b5f4290449caf8ec401ec0</data>
</node>
<node id="&quot;资本有机构成&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"资本有机构成是指不变资本和可变资本的比例关系。"</data>
  <data key="d2">chunk-0697a0db7d0db1790ba106df67fce0aa</data>
</node>
<node id="&quot;技术进步&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"技术进步是指生产过程中技术的改进和更新。"</data>
  <data key="d2">chunk-0697a0db7d0db1790ba106df67fce0aa</data>
</node>
<node id="&quot;劳动生产率&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"劳动生产率是指单位时间内劳动者生产的产品数量。"&lt;SEP&gt;"劳动生产率是指单位时间内生产的产品数量。"</data>
  <data key="d2">chunk-8bedb2f5fc0b60aee0c375ed03c7a25d&lt;SEP&gt;chunk-0697a0db7d0db1790ba106df67fce0aa</data>
</node>
<node id="&quot;劳动力再生产&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"劳动力再生产是指劳动者通过消费和休息等方式恢复劳动能力的过程。"</data>
  <data key="d2">chunk-0697a0db7d0db1790ba106df67fce0aa</data>
</node>
<node id="&quot;宁后&quot;">
  <data key="d0">"PERSON"</data>
  <data key="d1">"宁后是一个虚构的人物。"&gt;</data>
  <data key="d2">chunk-22fb66d705b5f4290449caf8ec401ec0</data>
</node>
<node id="&quot;人民群众&quot;">
  <data key="d0">"ORGANIZATION"</data>
  <data key="d1">"人民群众是社会历史的主体，是历史的创造者，体现了马克思主义的基本观点之一，强调在历史创造过程中的决定作用。"</data>
  <data key="d2">chunk-8bedb2f5fc0b60aee0c375ed03c7a25d</data>
</node>
<node id="&quot;行政制度&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"Administrative system refers to the organization and operation of the government's administrative units and functions."</data>
  <data key="d2">chunk-41183860ecf8e9826db112f1097e234e</data>
</node>
<node id="&quot;群众观点&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"群众观点是马克思主义的基本观点之一，强调人民群众的智慧和力量，要求贯彻党的群众路线。"</data>
  <data key="d2">chunk-8bedb2f5fc0b60aee0c375ed03c7a25d</data>
</node>
<node id="&quot;新时伐方案&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"新时伐方案是指针对新时代的解决方案。"&gt;</data>
  <data key="d2">chunk-22fb66d705b5f4290449caf8ec401ec0</data>
</node>
<node id="&quot;群众路线&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"群众路线是贯彻马克思主义群众观点的具体实践，强调从群众中来，到群众中去的工作方法。"</data>
  <data key="d2">chunk-8bedb2f5fc0b60aee0c375ed03c7a25d</data>
</node>
<node id="&quot;商品经济&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"商品经济是资本主义经济制度的基础，其价值规律和基本矛盾在政治经济学中进行了分析。"</data>
  <data key="d2">chunk-8bedb2f5fc0b60aee0c375ed03c7a25d</data>
</node>
<node id="&quot;私有制&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"私有制是资本主义经济制度的基础，其产生和形成在政治经济学中有所描述。"</data>
  <data key="d2">chunk-8bedb2f5fc0b60aee0c375ed03c7a25d</data>
</node>
<node id="&quot;苹果&quot;">
  <data key="d0">"PERSON"</data>
  <data key="d1">"苹果是一个虚构的人物。"&gt;</data>
  <data key="d2">chunk-22fb66d705b5f4290449caf8ec401ec0</data>
</node>
<node id="&quot;资本主义生产关系&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"资本主义生产关系是资本主义经济制度的核心，其产生和形成在政治经济学中有所阐述。"</data>
  <data key="d2">chunk-8bedb2f5fc0b60aee0c375ed03c7a25d</data>
</node>
<node id="&quot;社会分工&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"社会分工是商品经济产生的条件之一，指社会劳动划分成不同的行业和职业。"</data>
  <data key="d2">chunk-8bedb2f5fc0b60aee0c375ed03c7a25d</data>
</node>
<node id="&quot;劳动产品&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"劳动产品是指劳动者在生产过程中创造出来的产品。"</data>
  <data key="d2">chunk-8bedb2f5fc0b60aee0c375ed03c7a25d</data>
</node>
<node id="&quot;价值&quot;">
  <data key="d0">"CATEGORY"</data>
