  <data key="d0">"CATEGORY"</data>
  <data key="d1">"社会心理和社会意识形式是社会意识的两个层次，前者是基础，后者是高级形式。"</data>
  <data key="d2">chunk-f34069ac08b1c4bc66f348fd5d0391fa</data>
</node>
<node id="&quot;统一体&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"统一体是指矛盾双方相互依存、相互促进、共同发展的整体。"&gt;</data>
  <data key="d2">chunk-22fb66d705b5f4290449caf8ec401ec0</data>
</node>
<node id="&quot;矛盾&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"矛盾是事物内部或事物之间对立统一的范畴，存在于一切事物发展过程的始终。"&gt;</data>
  <data key="d2">chunk-22fb66d705b5f4290449caf8ec401ec0</data>
</node>
<node id="&quot;斗争性&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"斗争性是指矛盾双方相互排斥、相互对立的性质，推动事物发展。"&gt;</data>
  <data key="d2">chunk-22fb66d705b5f4290449caf8ec401ec0</data>
</node>
<node id="&quot;同一性&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"同一性是指矛盾双方相互吸引、相互联结的性质，使矛盾双方相互吸取有利于自身的因素，在相互作用中各自得到发展。"&gt;</data>
  <data key="d2">chunk-22fb66d705b5f4290449caf8ec401ec0</data>
</node>
<node id="&quot;质变&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"质变是事物性质的根本变化，是事物由一种质态向另一种质态的飞跃。"&gt;</data>
  <data key="d2">chunk-22fb66d705b5f4290449caf8ec401ec0</data>
</node>
<node id="&quot;量变&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"量变是事物数量的增减和组成要素排列次序的变动，是保持事物相对稳定性的状态。"&gt;</data>
  <data key="d2">chunk-22fb66d705b5f4290449caf8ec401ec0</data>
</node>
<node id="&quot;和谐&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"和谐是矛盾的一种特殊表现形式，体现着矛盾双方的相互依存、相互促进、共同发展。"&gt;</data>
  <data key="d2">chunk-22fb66d705b5f4290449caf8ec401ec0</data>
</node>
<node id="&quot;社会主义和谐社会&quot;">
  <data key="d0">"ORGANIZATION"</data>
  <data key="d1">"社会主义和谐社会是指在发展的基础上正确处理各种矛盾的过程和结果，实现社会的和谐、人与自然的和谐。"&gt;</data>
  <data key="d2">chunk-22fb66d705b5f4290449caf8ec401ec0</data>
</node>
<node id="&quot;发展&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"发展是指事物由小到大、由简到繁、由低级到高级的变化过程。"&gt;</data>
  <data key="d2">chunk-22fb66d705b5f4290449caf8ec401ec0</data>
</node>
<node id="&quot;条件&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"条件是指影响事物发展变化的外部环境或内部因素。"&gt;</data>
  <data key="d2">chunk-22fb66d705b5f4290449caf8ec401ec0</data>
</node>
<node id="&quot;因素&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"因素是指影响事物发展变化的直接原因。"&gt;</data>
  <data key="d2">chunk-22fb66d705b5f4290449caf8ec401ec0</data>
</node>
<node id="&quot;相互作用&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"相互作用是指事物之间相互影响、相互制约的关系。"&gt;</data>
  <data key="d2">chunk-22fb66d705b5f4290449caf8ec401ec0</data>
</node>
<node id="&quot;转化&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"转化是指事物从一种状态变为另一种状态的过程。"&gt;</data>
  <data key="d2">chunk-22fb66d705b5f4290449caf8ec401ec0</data>
</node>
<node id="&quot;平衡&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"平衡是指事物在相互作用中达到的稳定状态。"&gt;</data>
  <data key="d2">chunk-22fb66d705b5f4290449caf8ec401ec0</data>
</node>
<node id="&quot;协调&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"协调是指事物之间相互配合、相互支持的关系。"&gt;</data>
  <data key="d2">chunk-22fb66d705b5f4290449caf8ec401ec0</data>
</node>
<node id="&quot;合作&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"合作是指事物之间为了共同目标而进行的联合行动。"&gt;</data>
  <data key="d2">chunk-22fb66d705b5f4290449caf8ec401ec0</data>
</node>
<node id="&quot;相对性&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"相对性是指事物之间的关系是相对的，不是绝对的。"&gt;&lt;SEP&gt;"相对性是真理的另一个方面，指人们在一定条件下对客观事物及其本质和发展规律的正确认识总是有限度和不完善的。"</data>
  <data key="d2">chunk-deacddec126d0d0961d98e274841fd63&lt;SEP&gt;chunk-22fb66d705b5f4290449caf8ec401ec0</data>
</node>
<node id="&quot;适度原则&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"适度原则是指在认识和处理问题时，要把握事物的度，防止过度和不足。"&gt;</data>
  <data key="d2">chunk-22fb66d705b5f4290449caf8ec401ec0</data>
</node>
<node id="&quot;相对特定全&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"相对特定全是指在量变过程中，事物保持相对稳定的状态。"&gt;</data>
  <data key="d2">chunk-22fb66d705b5f4290449caf8ec401ec0</data>
</node>
<node id="&quot;社会历史发展的动力&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"The driving force of social historical development refers to the factors that propel and shape the progress of history."</data>
  <data key="d2">chunk-41183860ecf8e9826db112f1097e234e</data>
</node>
<node id="&quot;历史选择性&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"Historical selectivity refers to the capacity of human beings to make choices and decisions that shape the course of history."</data>
  <data key="d2">chunk-41183860ecf8e9826db112f1097e234e</data>
</node>
<node id="&quot;历史的前进性&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"Historical progressiveness refers to the forward movement and development of history over time."</data>
  <data key="d2">chunk-41183860ecf8e9826db112f1097e234e</data>
</node>
<node id="&quot;历史曲折性&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"Historical曲折性 refers to the irregular and winding nature of historical development, characterized by ups and downs and setbacks."</data>
  <data key="d2">chunk-41183860ecf8e9826db112f1097e234e</data>
</node>
<node id="&quot;历史顺序性&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"Historical sequence refers to the orderly progression of historical events and developments."</data>
  <data key="d2">chunk-41183860ecf8e9826db112f1097e234e</data>
</node>
<node id="&quot;历史跨越性&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"Historical leap refers to the sudden, significant jumps in historical development, often brought about by major events or changes."</data>
  <data key="d2">chunk-41183860ecf8e9826db112f1097e234e</data>
</node>
<node id="&quot;唯物史观考察历史创造者问题的原则&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"The principles of materialist historical view in examining the creators of history refer to the criteria used to determine who the creators of history are according to Marxist philosophy."</data>
  <data key="d2">chunk-41183860ecf8e9826db112f1097e234e</data>
</node>
<node id="&quot;社会历史发展的必然性&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"The necessity of social historical development refers to the inevitability of the progression and change of society and history."</data>
  <data key="d2">chunk-41183860ecf8e9826db112f1097e234e</data>
</node>
<node id="&quot;辩证否定观&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"辩证否定观是哲学上关于事物发展的一种观点，强调事物发展的自我否定和连续性。"</data>
  <data key="d2">chunk-2b0ae703b9160ae0b111f99f11ae13c4</data>
</node>
<node id="&quot;事物自我否定&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"事物自我否定是指事物在其发展过程中通过否定自身来推动自身的发展。"</data>
  <data key="d2">chunk-2b0ae703b9160ae0b111f99f11ae13c4</data>
</node>
<node id="&quot;事物发展的环节&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"事物发展的环节指事物在发展过程中经历的各个阶段或步骤。"</data>
  <data key="d2">chunk-2b0ae703b9160ae0b111f99f11ae13c4</data>
</node>
<node id="&quot;新旧事物联系&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"新旧事物联系指事物在其发展过程中新旧之间的相互作用和影响。"</data>
  <data key="d2">chunk-2b0ae703b9160ae0b111f99f11ae13c4</data>
</node>
<node id="&quot;否定规律&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"否定规律是事物发展过程中的一种普遍规律，揭示了事物发展的前进性和曲折性的统一。"</data>
  <data key="d2">chunk-2b0ae703b9160ae0b111f99f11ae13c4</data>
</node>
<node id="&quot;肯定-否定-否定之否定&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"肯定-否定-否定之否定是事物发展过程中经历的两个否定和一个肯定的过程，形成一个周期性的发展模式。"</data>
  <data key="d2">chunk-2b0ae703b9160ae0b111f99f11ae13c4</data>
</node>
<node id="&quot;文化自信&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"文化自信是对自身文化价值的认同和信任，是一种积极的文化心态。"</data>
  <data key="d2">chunk-2b0ae703b9160ae0b111f99f11ae13c4</data>
</node>
<node id="&quot;主观辩证法&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"主观辩证法是客观辩证法在人的思维中的反映，是人们对客观辩证法的认识和运用。"</data>
  <data key="d2">chunk-2b0ae703b9160ae0b111f99f11ae13c4</data>
</node>
<node id="&quot;矛盾分析方法&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"矛盾分析方法是一种认识方法，强调在事物的发展过程中，要看到事物内部的矛盾和外部矛盾。"</data>
  <data key="d2">chunk-2b0ae703b9160ae0b111f99f11ae13c4</data>
</node>
<node id="&quot;思维能力&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"思维能力是指人们在认识世界和改造世界中运用知识的能力。"</data>
  <data key="d2">chunk-2b0ae703b9160ae0b111f99f11ae13c4</data>
</node>
<node id="&quot;实践与认识&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"实践与认识是哲学上关于实践和认识之间关系的理论，强调实践是认识的基础。"</data>
  <data key="d2">chunk-2b0ae703b9160ae0b111f99f11ae13c4</data>
</node>
<node id="&quot;感性认识&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"感性认识是认识的初级阶段，包括感觉、知觉、表象等形式。"&lt;SEP&gt;"感性认识是认识过程中的第一阶段，包括直觉、联想、想象和猜测等非理性因素。"&lt;SEP&gt;"感性认识是通过感官直接感知事物的认识。"</data>
  <data key="d2">chunk-deacddec126d0d0961d98e274841fd63&lt;SEP&gt;chunk-2b0ae703b9160ae0b111f99f11ae13c4</data>
</node>
<node id="&quot;理性认识&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"理性认识是认识的高级阶段，通过思维对事物进行抽象和概括。"&lt;SEP&gt;"理性认识是认识的高级阶段，通过思维对概念、判断、推理等形式进行。"&lt;SEP&gt;"理性认识是认识过程中的第二阶段，从感性认识到理性认识的飞跃，是认识过程中的第二次能动的飞跃。"</data>
  <data key="d2">chunk-deacddec126d0d0961d98e274841fd63&lt;SEP&gt;chunk-2b0ae703b9160ae0b111f99f11ae13c4</data>
</node>
<node id="&quot;辩证唯物主义认识论&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"辩证唯物主义认识论是建立在实践基础上的能动的反映论，强调认识是实践的基础。"</data>
  <data key="d2">chunk-2b0ae703b9160ae0b111f99f11ae13c4</data>
</node>
<node id="&quot;感性直观&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"感性直观是感性认识的直接性特点，强调认识的直接性。"&lt;SEP&gt;"感性直观是认识的初级阶段，通过感官直接感知事物。"</data>
  <data key="d2">chunk-2b0ae703b9160ae0b111f99f11ae13c4</data>
</node>
<node id="&quot;理性认识飞跃&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"理性认识飞跃是指从感性认识到理性认识的转变过程。"</data>
  <data key="d2">chunk-2b0ae703b9160ae0b111f99f11ae13c4</data>
</node>
<node id="&quot;认识过程&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"认识过程是指人们在实践中不断认识世界和改造世界的过程。"</data>
  <data key="d2">chunk-2b0ae703b9160ae0b111f99f11ae13c4</data>
</node>
<node id="&quot;否定因素&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"否定因素指那些促使事物灭亡或阻碍事物发展的因素。"</data>
  <data key="d2">chunk-2b0ae703b9160ae0b111f99f11ae13c4</data>
</node>
<node id="&quot;基本内容&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"基本内容指某一理论或概念的核心内容和主要观点。"</data>
  <data key="d2">chunk-2b0ae703b9160ae0b111f99f11ae13c4</data>
</node>
<node id="&quot;辩证下定&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"辩证下定指事物发展过程中的确定性和不确定性。"</data>
  <data key="d2">chunk-2b0ae703b9160ae0b111f99f11ae13c4</data>
</node>
<node id="&quot;前进性与曲折性的统一&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"前进性与曲折性的统一指事物发展过程中既有前进性又有曲折性的特点。"</data>
  <data key="d2">chunk-2b0ae703b9160ae0b111f99f11ae13c4</data>
</node>
<node id="&quot;辩证发展过程&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"辩证发展过程指事物在发展过程中经历的各个阶段和变化。"</data>
  <data key="d2">chunk-2b0ae703b9160ae0b111f99f11ae13c4</data>
</node>
<node id="&quot;肯定-否定-到否定之否定三个阶段&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"肯定-否定-到否定之否定三个阶段指事物发展过程中经历的两个否定和一个肯定的过程。"</data>
  <data key="d2">chunk-2b0ae703b9160ae0b111f99f11ae13c4</data>
</node>
<node id="&quot;周期性&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"周期性指事物发展过程中重复出现的过程或模式。"</data>
  <data key="d2">chunk-2b0ae703b9160ae0b111f99f11ae13c4</data>
</node>
<node id="&quot;同一&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"同一指事物内部的统一性和一致性。"</data>
  <data key="d2">chunk-2b0ae703b9160ae0b111f99f11ae13c4</data>
</node>
<node id="&quot;斗争&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"斗争指事物之间或事物内部对立双方的相互作用和斗争。"</data>
  <data key="d2">chunk-2b0ae703b9160ae0b111f99f11ae13c4</data>
</node>
<node id="&quot;新同一&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"新同一指事物在斗争和发展过程中达到的新的一致性和统一性。"</data>
  <data key="d2">chunk-2b0ae703b9160ae0b111f99f11ae13c4</data>
</node>
<node id="&quot;态形式&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"态形式指事物发展过程中不同状态的形式或表现。"</data>
  <data key="d2">chunk-2b0ae703b9160ae0b111f99f11ae13c4</data>
</node>
<node id="&quot;量变-质变-新量变&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"量变-质变-新量变指事物在发展过程中经历的从量变到质变，再到新量变的过程。"</data>
  <data key="d2">chunk-2b0ae703b9160ae0b111f99f11ae13c4</data>
</node>
<node id="&quot;展过程&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"展过程指事物发展过程中的展开和进展。"</data>
  <data key="d2">chunk-2b0ae703b9160ae0b111f99f11ae13c4</data>
</node>
<node id="&quot;肯定-否定-新肯定&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"肯定-否定-新肯定指事物发展过程中经历的两个否定和一个肯定的过程。"</data>
  <data key="d2">chunk-2b0ae703b9160ae0b111f99f11ae13c4</data>
</node>
<node id="&quot;形而上学否定观&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"形而上学否定观是一种哲学观点，认为事物的存在与否是绝对的，非此即彼。"</data>
  <data key="d2">chunk-2b0ae703b9160ae0b111f99f11ae13c4</data>
</node>
<node id="&quot;鬼话&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"鬼话指虚假或无意义的话。"</data>
  <data key="d2">chunk-2b0ae703b9160ae0b111f99f11ae13c4</data>
</node>
<node id="&quot;文化自信(但所有的都要去除封建立场)&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"文化自信(但所有的都要去除封建立场)指在文化自信的同时要去除陈旧和保守的立场。"</data>
  <data key="d2">chunk-2b0ae703b9160ae0b111f99f11ae13c4</data>
</node>
<node id="&quot;认识论&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"认识论是哲学上关于认识的理论，研究认识的起源、本质和发展规律。"</data>
  <data key="d2">chunk-2b0ae703b9160ae0b111f99f11ae13c4</data>
</node>
<node id="&quot;认识的本质与过程&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"认识的本质与过程是认识论的核心内容，探讨认识的本质和认识的发展过程。"</data>
  <data key="d2">chunk-2b0ae703b9160ae0b111f99f11ae13c4</data>
</node>
<node id="&quot;唯物主义反动论&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"唯物主义反动论是哲学上的一种观点，认为认识是物质的反映。"</data>
  <data key="d2">chunk-2b0ae703b9160ae0b111f99f11ae13c4</data>
</node>
<node id="&quot;唯心主义先验论&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"唯心主义先验论是哲学上的一种观点，认为认识是先于物质存在的。"</data>
  <data key="d2">chunk-2b0ae703b9160ae0b111f99f11ae13c4</data>
</node>
<node id="&quot;感性认识到理性认识的飞跃&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"感性认识到理性认识的飞跃是认识发展过程中的一个重要阶段，从感性认识到理性认识的转变。"</data>
  <data key="d2">chunk-2b0ae703b9160ae0b111f99f11ae13c4</data>
</node>
<node id="&quot;理性认识的三种形式&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"理性认识的三种形式是概念、判断、推理。"</data>
  <data key="d2">chunk-2b0ae703b9160ae0b111f99f11ae13c4</data>
</node>
<node id="&quot;感性认识有待于发展为理性认识&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"感性认识有待于发展为理性认识指感性认识需要进一步发展成为理性认识。"</data>
  <data key="d2">chunk-2b0ae703b9160ae0b111f99f11ae13c4</data>
</node>
<node id="&quot;理性认识依赖于感性认识&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"理性认识依赖于感性认识指理性认识建立在感性认识的基础上。"</data>
  <data key="d2">chunk-2b0ae703b9160ae0b111f99f11ae13c4</data>
</node>
<node id="&quot;感性认识和理性认识又是相互包含、互相渗透&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"感性认识和理性认识又是相互包含、互相渗透指感性认识和理性认识之间存在着相互联系和相互作用。"</data>
  <data key="d2">chunk-2b0ae703b9160ae0b111f99f11ae13c4</data>
</node>
<node id="&quot;实践&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"实践是指人们在社会生活中改造客观世界和主观世界的一切活动，是理解社会现象的钥匙。"&lt;SEP&gt;"实践是认识过程的第二阶段，理性认识到实践的飞跃，是实践、认识、再实践、再认识，循环往复的过程。"</data>
  <data key="d2">chunk-deacddec126d0d0961d98e274841fd63&lt;SEP&gt;chunk-15983329068bd701678476a4f18ab8b1</data>
</node>
<node id="&quot;真理&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"真理是标志主观与客观相符合的哲学范畴，是对客观事物及其本质和发展规律的正确反映。"</data>
  <data key="d2">chunk-deacddec126d0d0961d98e274841fd63</data>
</node>
<node id="&quot;客观性&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"客观性是真理的本质属性，指真理的内容是对客观事物及其本质和发展规律的正确反映。"</data>
  <data key="d2">chunk-deacddec126d0d0961d98e274841fd63</data>
</node>
<node id="&quot;绝对性&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"绝对性是真理的一个方面，指任何真理都标志着主观和客观之间的符合，包含着不依赖于人和人的意识的客观内容。"</data>
  <data key="d2">chunk-deacddec126d0d0961d98e274841fd63</data>
</node>
<node id="&quot;绝对主义&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"绝对主义是一种形而上学的真理观，认为真理是绝对的、不变的。"</data>
  <data key="d2">chunk-deacddec126d0d0961d98e274841fd63</data>
</node>
<node id="&quot;相对主义&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"相对主义是一种形而上学的真理观，认为真理是相对的、可变的。"</data>
  <data key="d2">chunk-deacddec126d0d0961d98e274841fd63</data>
</node>
<node id="&quot;实践标准&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"实践标准是检验真理的唯一标准，由真理的本性和时间的特点决定。"</data>
  <data key="d2">chunk-deacddec126d0d0961d98e274841fd63</data>
</node>
<node id="&quot;价值论&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"价值论是关于价值本质和属性的理论，包括客观主义价值论和主观主义价值论。"</data>
  <data key="d2">chunk-deacddec126d0d0961d98e274841fd63</data>
</node>
<node id="&quot;主体性&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"主体性是指价值关系中主体的地位和作用。"</data>
  <data key="d2">chunk-deacddec126d0d0961d98e274841fd63</data>
</node>
<node id="&quot;社会历史性&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"社会历史性是指价值关系受到社会历史条件的影响。"</data>
  <data key="d2">chunk-deacddec126d0d0961d98e274841fd63</data>
</node>
<node id="&quot;多维性&quot;">
  <data key="d0">"CATEGORY"</data>
  <data key="d1">"多维性是指价值关系具有多个方面的属性。"</data>
  <data key="d2">chunk-deacddec126d0d0961d98e274841fd63</data>
</node>
<node id="&quot;客观主义价值论&quot;">
  <data key="d0">"CATEGORY"</data>
